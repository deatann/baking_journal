# Copy this file to .env.local for local development.
# Never commit .env.local to git (it's already in .gitignore).

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API key, used for everything AI-related: Scan & Convert reads recipe
# photos directly (image -> structured recipe in one call), and Import from
# text parses pasted text (falling back to the local heuristic parser if that
# call fails). Get one at https://aistudio.google.com/apikey - works on the
# free tier, no billing account required.
# Server-side only - no NEXT_PUBLIC_ prefix, never exposed to the browser.
GEMINI_API_KEY=
